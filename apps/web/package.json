{
  "name": "@lamikraft/web",
  "version": "0.1.0",
  "private": true,
  "description": "Lamikraft One web application (Next.js App Router)",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../../backend/openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tanstack/react-query": "5.104.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "motion": "14.1.0",
    "next": "16.4.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
