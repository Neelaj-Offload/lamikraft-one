{
  "name": "@lamikraft/one",
  "version": "0.1.0",
  "private": true,
  "description": "Lamikraft One web application, rebuilt on the Lamikraft design system (Next.js App Router)",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "tokens": "node scripts/gen-tokens.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "lucide-react": "1.72.0",
    "motion": "14.1.0",
    "next": "16.4.4",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "typescript": "5.9.3"
  }
}
