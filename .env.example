# Lamikraft One - environment reference. Placeholders only: this file holds no secrets.
#
# Do not copy this file by hand. `npm run setup` runs `lk env init --slot 0`, which writes the
# repository-root .env with generated secrets and the ports for its worktree slot
# (from backend/: uv run python -m app.cli env init --slot N [--force]).
# Real environment variables override .env. Always use 127.0.0.1, never localhost.
# Values containing spaces must be single-quoted: LK_STORAGE_DIR='D:/Lamikraft ERP/backend/var'.

# --- runtime ---------------------------------------------------------------------------------
# development | test | production. `npm run test:api` and `npm run test:e2e` force test.
LK_ENV=development
# Worktree slot 0-9. Sets the ports below (api 8000+10N, web 3000+10N, e2e 8100+10N / 3100+10N)
# and the database names (lk_wt<N>, lk_wt<N>_test).
LK_SLOT=0
LK_DEFAULT_TIME_ZONE=Asia/Kolkata
# DEBUG | INFO | WARNING | ERROR. JSON logs are for production log shipping.
LK_LOG_LEVEL=INFO
LK_LOG_JSON=false

# --- database --------------------------------------------------------------------------------
# docker compose service "postgres" (container lk-postgres), shared by every worktree.
LK_PG_HOST=127.0.0.1
LK_PG_PORT=54329
LK_DB_NAME=lk_wt0
# Superuser: used only by `lk db ensure-roles|create|drop|status` and the test harness.
LK_PG_SUPERUSER=postgres
LK_PG_SUPERUSER_PASSWORD=<generated: copied from ~/.lamikraft-dev/dev-secrets.env>
# lk_owner owns the schema and runs migrations.
LK_DB_OWNER_USER=lk_owner
LK_DB_OWNER_PASSWORD=<generated: copied from ~/.lamikraft-dev/dev-secrets.env>
# lk_app is the runtime role: not superuser, NOBYPASSRLS, no DDL, 30 s statement timeout.
LK_DB_APP_USER=lk_app
LK_DB_APP_PASSWORD=<generated: copied from ~/.lamikraft-dev/dev-secrets.env>
LK_DB_POOL_SIZE=10

# --- http, ports and origins -----------------------------------------------------------------
LK_API_HOST=127.0.0.1
LK_API_PORT=8000
LK_WEB_PORT=3000
LK_E2E_API_PORT=8100
LK_E2E_WEB_PORT=3100
# The browser origin. Origin/CSRF checks compare against it exactly; never a wildcard.
LK_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Where Next.js rewrites /api/* (server side only).
LK_API_INTERNAL_URL=http://127.0.0.1:8000
# Reverse proxies in front of the web server that append the client address to X-Forwarded-For,
# counted from the right. 0 (development) trusts nothing in the header. Must be 1 behind the
# production reverse proxy, or per-IP sign-in limits share one bucket (a startup warning says so).
# uvicorn always runs with --no-proxy-headers; this setting is the only proxy trust.
LK_TRUSTED_PROXY_HOPS=0

# --- application secrets ---------------------------------------------------------------------
# Session and token signing. Generated per worktree: secrets.token_urlsafe(64).
LK_SECRET_KEY=<generated>
# Data-at-rest encryption keys (MFA secrets, provider tokens): "kid:base64(32 bytes)", comma
# separated, newest first. Back them up separately: losing them forces MFA re-enrolment.
LK_DATA_ENCRYPTION_KEYS=k1:<generated base64 of 32 random bytes>

# --- file storage ----------------------------------------------------------------------------
# local_fs (default) | s3
LK_STORAGE_BACKEND=local_fs
# Absolute path; lk env init uses backend/var/storage-slot<N>.
LK_STORAGE_DIR='<repo>/backend/var/storage-slot0'
LK_MAX_UPLOAD_BYTES=26214400
# S3 (only with LK_STORAGE_BACKEND=s3). For the dev MinIO profile use http://127.0.0.1:9000
# with the LK_MINIO_ROOT_* values below; in production use your provider's endpoint.
LK_S3_ENDPOINT_URL=
LK_S3_BUCKET=
LK_S3_REGION=
# Standard AWS SDK credential variables, read by boto3. Leave empty to use an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Dev-only MinIO (compose profile "s3", `npm run db:up -- --s3`). Generated into the shared file.
LK_MINIO_ROOT_USER=lk-minio
LK_MINIO_ROOT_PASSWORD=<generated: copied from ~/.lamikraft-dev/dev-secrets.env>

# --- AI providers ----------------------------------------------------------------------------
# demo: deterministic, labelled "Demo" adapters, no keys needed.
# live: real providers; startup fails visibly when a required key is missing.
LK_AI_MODE=demo
# Vendor-standard names, read only by the server; never exposed to the browser.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model routing overrides (defaults tuned for cost; also configurable in Settings > AI routing).
LK_MODEL_ORCHESTRATOR=claude-sonnet-5-5
LK_MODEL_ESCALATION=claude-opus-5-5
LK_MODEL_PHRASING=claude-haiku-5-5
LK_MODEL_VISION=gemini-3.8-flash
# Web: assistant run progress streams over Server-Sent Events (ADR-059); 0 forces 500 ms polling.
# NEXT_PUBLIC_LK_ASSISTANT_SSE=1

# --- WhatsApp Business (Cloud API) -----------------------------------------------------------
# demo: a local provider posts signed payloads through the real webhook route.
# live: needs every value below, from the Meta app and WhatsApp Business Account.
LK_WHATSAPP_MODE=demo
LK_WHATSAPP_PHONE_NUMBER_ID=
LK_WHATSAPP_WABA_ID=
LK_WHATSAPP_ACCESS_TOKEN=
# Verifies the X-Hub-Signature-256 HMAC on every webhook delivery.
LK_WHATSAPP_APP_SECRET=
# Echoed back during the webhook subscription handshake.
LK_WHATSAPP_VERIFY_TOKEN=
# Previous app secret, accepted during a rotation (leave empty otherwise).
LK_WHATSAPP_APP_SECRET_PREVIOUS=
# Graph API version used for every Cloud API call (changelog checked 2026-11-03: v26.0 current).
LK_WHATSAPP_API_VERSION=v26.0
# Live mode never sends unless this is true; the development allowlist (E.164, comma separated) limits recipients.
LK_WHATSAPP_LIVE_OUTBOUND=false
LK_WHATSAPP_DEV_ALLOWLIST=

# --- email -----------------------------------------------------------------------------------
# demo: writes .eml files under backend/var/mail and never claims a send.
# smtp: sends through the server below.
LK_EMAIL_MODE=demo
LK_SMTP_HOST=
LK_SMTP_PORT=587
LK_SMTP_USERNAME=
LK_SMTP_PASSWORD=
# starttls | ssl | none
LK_SMTP_SECURITY=starttls
LK_SMTP_FROM='Lamikraft One <no-reply@example.com>'

# --- local tooling (not read by the app) -----------------------------------------------------
# Machine-shared directory for dev-secrets.env and the e2e lock (default ~/.lamikraft-dev).
# LK_DEV_HOME=
